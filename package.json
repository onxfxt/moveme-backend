{
  "name": "moveme-backend",
  "version": "1.0.0",
  "description": "moveMe production backend — Express API + Prisma + Socket.io",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:generate": "prisma generate",
    "seed:admin": "node prisma/seed-admin.js",
    "loadtest:race:setup": "node loadtest/setup-race-condition-test.js",
    "loadtest:race:run": "artillery run loadtest/race-condition.yml",
    "loadtest:race:verify": "node loadtest/verify-race-result.js",
    "loadtest:wallet:setup": "node loadtest/setup-wallet-burst-test.js",
    "loadtest:wallet:run": "artillery run loadtest/wallet-burst.yml",
    "loadtest:wallet:verify": "node loadtest/verify-wallet-result.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.7.5",
    "twilio": "^5.3.0",
    "expo-server-sdk": "^3.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^5.19.1",
    "artillery": "^2.0.19"
  }
}
